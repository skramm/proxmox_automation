		--silent -X POST \
		-H "Authorization: PVEAPIToken=${PVUSER}@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		"https://${APINODE}.${DOMAIN}:${PORT}/api2/json/nodes/$BASENODE/qemu/$TVMID/clone" \
		--data-urlencode node=$BASENODE \
		--data-urlencode vmid=$TVMID \
		--data-urlencode newid=$VMID \
		--data-urlencode name=$VMNAME \
		--data-urlencode description="$DESC")
	err=$?
	CheckError

	echo " -Ajout des tags"
	ApiCall POST "/api2/json/nodes/$BASENODE/qemu/$VMID/config?node=$BASENODE&vmid=$VMID&tags=$TAGS"

	echo " -configuration permissions (roles)"
# ref: https://pve.proxmox.com/pve-docs/api-viewer/#/access/acl
	response=$(curl --insecure --silent \
		-X PUT \
		-H "Authorization: PVEAPIToken=${PVUSER}@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		--data-urlencode "path=/vms/$VMID" \
		--data-urlencode "users=$IDU1" \
		--data-urlencode "roles=PVEVMUser;PVEVMAdmin" \
		--data-urlencode "propagate=1" \
		"https://${APINODE}.${DOMAIN}:${PORT}/api2/json/access/acl")
	err=$?
	CheckError

	((NUMA++))
done <data_group_${GROUPSEL}.csv
}

#================================================================
# Delete a set of VM holding a given tag
function DeleteVmByTag()
{
	if ! [ -f data_tags.csv ]
	then
		echo "Erreur, fichier 'data_tags.csv' inaccessible"
		exit 1
	fi

	TAGDEL=$(zenity --list --height=300 \
		--text="Quel machines ayant le tag ci-dessous souhaitez-vous détruire?" --column="tags" ${TAGARR[@]})
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

# count VM only (not templates, as these will not be deleted)
#echo "TAGDEL=$TAGDEL"
	COUNT=0
	IFS=";"; while read -a ARR
	do
		if [ ${ARR[3]} = 0 ]; then ((COUNT++)); fi
	done < data_tag_${TAGDEL}.csv

	zenity --question --text \
		"Ok pour effacer les ${COUNT} VMs associées au tag $TAGDEL?"
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi


#-------------------------
# Delete VMs
# TODO: pas plus simple de lire dans le fichier tags_XXXX.csv ???

COMPT=0
IFS=";"; while read -a TAB
do
	if ! [ "${TAB[3]}" = "" ]; then
		IFS=","; read -r -a TAGS <<< "${TAB[3]}"; IFS=";"
		for ((i=0; i<${#TAGS[@]}; i++))
		do
			tag=${TAGS[$i]}
#				echo "node ${TAB[0]}: machine ${TAB[2]}, tag=$tag"
			if [ $tag = $TAGDEL ]; then
				if [ "${TAB[4]}" = "1" ]; then
					echo "node ${TAB[0]}: machine ${TAB[2]}, id=${TAB[1]} est un template, pas de suppression"
				else
					echo "node ${TAB[0]}: suppression machine ${TAB[2]}, id=${TAB[1]}"
					ApiCall DELETE "/api2/json/nodes/${TAB[0]}/qemu/${TAB[1]}?node=${TAB[0]}&vmid=${TAB[1]}"
					((COMPT++))
				fi
			fi
		done
	fi
done <data_node_ALL.csv

echo "-$COMPT VM supprimées, appuyer sur une touche"
read
}


