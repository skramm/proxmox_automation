function ViewStorageDetails()
{
	if [ "$DEBUG" = "Y" ]; then echo "FUNCTION $FUNCNAME" >>debug.log ; fi

	echo "Gathering detailed CEPH storage data..."
# CEPH
	ApiCall GET "/api2/json/nodes/$APINODE/storage/$CEPH_SSD_NAME/content"
	jq -r '.data[]' <<< "$response" >/tmp/proxmox/storage_SSD.json
	jq -r '(.vmid|tostring) + ";" + (.size|tostring) + ";" + (.parent//"0") + ";" + .name' </tmp/proxmox/storage_SSD.json >data_storage_SSD.csv

	ApiCall GET "/api2/json/nodes/$APINODE/storage/$CEPH_HDD_NAME/content"
	jq -r '.data[]' <<< "$response" >/tmp/proxmox/storage_HDD.json
	jq -r '(.vmid|tostring) + ";" + (.size|tostring) + ";" + (.parent//"0") + ";" + .name' </tmp/proxmox/storage_HDD.json >data_storage_HDD.csv

	echo "Processing data..."
	rm data_orphaned_disks.csv 2>/dev/null
	checkCEPH data_storage_SSD.csv SSD
	checkCEPH data_storage_HDD.csv HDD

	if [ $(wc -l<data_orphaned_disks.csv) = 0 ]; then echo "No orphaned disks!"; return; fi

	t=(HDD SSD)
	ANSWER=$(zenity --list --height=300 --text="Delete orphaned disk?" --column="Disk type" ${t[@]})
	if [ $? != 0 ]; then
		echo "Interruption"; return
	fi

	COUNT=$(wc -l <data_storage_HDD.csv)
	DFILE=data_storage_HDD.csv
	CEPH_NAME=$CEPH_HDD_NAME
	if [ $ANSWER = SSD ]; then
		COUNT=$(wc -l <data_storage_SSD.csv);
		DFILE=data_storage_SSD.csv
		CEPH_NAME=$CEPH_SSD_NAME
	fi

	echo "COUNT=$COUNT DFILE=$DFILE CEPH_NAME=$CEPH_NAME"
	DOIT=$(zenity --question --text "Ok to delete $COUNT orphaned disks on $ANSWER storage?")
	if [ $? != 0 ]; then
		echo "Interruption"; return
	fi

	IFS=";"; while read -a TAB
	do
		if [ ${TAB[0]} = $ANSWER ]; then
			echo " -Delete volume ${TAB[4]} (${TAB[3]})" | tee -a $LOGFILE
#		ApiCall DELETE "/api2/json/nodes/$APINODE/storage/$CEPH_NAME/content/${TAB[3]}"
		fi
	done <$data_orphaned_disks.csv

	echo "done"
}

