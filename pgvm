#------------------------------------------------------
# arg1: csv filename holding either HDD or SSD disk data
# arg2: SSD or HDD
function checkCEPH()
{
	NBD_ORPHAN=0
	TOT_SIZE=0
	IFS=";"; while read -a TAB
	do
#		echo "Checking machine ${TAB[0]} size=${TAB[1]} s_MB = $(bc <<< ${TAB[1]}/1000000) TOT_SIZE=$TOT_SIZE"
		checkVM ${TAB[0]}
		if [ $? != 0 ]; then
			((NBD_ORPHAN++));
			((TOT_SIZE+=${TAB[1]}));
			echo "$2;${TAB[0]};${TAB[1]};${TAB[2]};${TAB[3]}" >>data_orphaned_disks.csv
		fi

	done <$1
	TSIZEG=$(bc <<< $TOT_SIZE/1000000000)
	echo "Nb of VM disks on $2 storage: $(wc -l < $1), with $NBD_ORPHAN orphaned disks, using $TSIZEG GB"
}

