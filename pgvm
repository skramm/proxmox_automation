function ToolCheck()
{
	which $1 >/dev/null
	if ! [ $? = 0 ]; then
		echo "Error: program '$1' not available, please install"
		exit 1
	fi
}
#================================================================
function VarCheck()
{
	if [ "$1" = "" ]; then
		echo "Error: variable '$2' is empty, please check manual and file '$TOKEN_FILE'"
		exit 1
	fi
}


