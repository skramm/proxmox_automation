#================================================================
function ApiCall()
{
# TODO remove this, pointless
	if [ "$DEBUG" = "Y" ]; then
		if [ "$2" = "" ]
		then
			echo "Internal error, endpoint missing"
			exit 1
		fi
		if [ "$1" = "" ]
		then
			echo "Internal error, POST or GET missing"
			exit 1
		fi
	fi

# if no response within 5 s., abort
	response=$(curl --insecure \
		--connect-timeout 5 \
		--silent -X $1 \
		-H "Authorization: PVEAPIToken=${PVUSER}@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		"https://${APINODE}.${DOMAIN}:${PORT}$2")
	err=$?
	if ! [ $err = 0 ];
	then
		echo "Error: API call failure, HTTP method='$1', endpoint='$2'"
		echo -e " -curl return value: $err\n -API response: $response"
		exit 1
	fi

#	if [ "$DEBUG" = "Y" ]; then
#		echo "DEBUG: ApiCall $1 $2"
#		echo "DEBUG: response=$response"
#	fi
}


#================================================================
# Fetch data of a given node ($1), called by FetchData()
function ProcessNode()
{
	echo "ProcessNode(): $1"
	if [ "$DEBUG" = "Y" ]; then echo "FUNCTION $FUNCNAME -$1-" >>debug.log ; fi

	ApiCall GET "/api2/json/nodes/$1/qemu?full=1"
	jq -r '.data[]' <<< "$response" >/tmp/proxmox/node_$1.json

# we use the '_' character to separate fields because in the json file, multiple tags are separated with ';'
# (and '_' is not allowed in the VM name field)
	jq -r '(.vmid|tostring) + "_" + .name + "_" + .tags + "_" + (.template|tostring) + "_" + .status' </tmp/proxmox/node_$1.json >/tmp/proxmox/node_$1.csv

# replace null by 0 (machine is not a template), just to make it prettier
	sed -i -e 's/_null/_0/g' /tmp/proxmox/node_$1.csv

# replace the semi-colon separating tags with a comma
	sed -i -e 's/;/,/g' /tmp/proxmox/node_$1.csv

# replace the underscore by semi-colon
	sed -i -e 's/_/;/g' /tmp/proxmox/node_$1.csv

# sort by name
	sort --key=1 /tmp/proxmox/node_$1.csv >/tmp/proxmox/data_node2_$1.csv

# Add type and disk config
# Depending on machine type, the disk will be encode in the API response either as
# "scsi0" (Linux, probably?) or "ide0" (Windows?)
	IFS=";"; while read -a VM
	do
		ID=${VM[0]}
		ApiCall GET "/api2/json/nodes/$1/qemu/$ID/config"
		if [ "$DEBUG" = "Y" ]; then echo -e "\n-node=$1 VMID=$ID config-response=$response" >>debug.log ;fi

		DISK=$(jq -r '.data.scsi0' <<< "$response")
		if [ "$DISK" = "null" ]; then
			DISK=$(jq -r '.data.ide0' <<< "$response")
		fi
		if [ "$DISK" = "null" ]; then
			DISK=$(jq -r '.data.efidisk0' <<< "$response")
		fi

		if [ "$DEBUG" = "Y" ]; then echo "node=$1 ID=$ID DISK=$DISK" >>debug.log; fi
		IFS=","; while read -a ARR2
		do
			D1=${ARR2[0]}
			if [ "$DEBUG" = "Y" ]; then echo "D1=$D1" >>debug.log; fi
			OLDIFS="$IFS"; IFS=":"; while read -a ARR3
			do
#echo "ARR3[0]=${ARR3[0]}" >>debug.log
				echo -n "${VM[0]};${VM[1]};${VM[2]};${VM[3]};${VM[4]};" >>data_node_$1.csv
				if [ ${ARR3[0]} = $CEPH_HDD_NAME ]; then
					echo -n "HDD" >>data_node_$1.csv
				else
					if [ ${ARR3[0]} = $CEPH_SSD_NAME ]; then
						echo -n "SSD" >>data_node_$1.csv
					else
						echo -n "XXX" >>data_node_$1.csv
					fi
				fi
# determine if full clone or linked clone
				DNAME=${ARR3[1]}
#				if [ "$DEBUG" = "Y" ]; then echo "DNAME=$DNAME, ${DNAME:0:4}" >>debug.log; fi
				if [ "${DNAME:0:4}" = "base" ]; then
#					echo ";LC;" >>data_node_$1.csv
					OLDIFS="$IFS"; IFS="/"; while read -a ARR4
					do
						echo "| ${ARR4[0]} | ${ARR4[1]} |">>debug.log;
						OLDIFS="$IFS"; IFS="-"; while read -a ARR5
						do
							echo ";LC;${ARR5[1]}" >>data_node_$1.csv
						done <<<${ARR4[0]}; IFS="$OLDIFS"

					done <<<$DNAME; IFS="$OLDIFS"
				else
					echo ";FC;FC" >>data_node_$1.csv
				fi
			done <<< $D1; IFS="$OLDIFS"
		done <<<$DISK; IFS=";"
	done </tmp/proxmox/data_node2_$1.csv


# Add node name on each line of global file, first position
	IFS=";"; while read line;
	do
		echo "$1;${line}" >>data_node_ALL.csv
 	done < data_node_$1.csv

	IFS=";"; while read -a ARR
	do
# comptage du nb d'occurrence pour chaque tag
# TODO: supprimer quand on aura les csv par tag
		if ! [ "${ARR[2]}" = "" ]
		then
			tags=${ARR[2]}
			IFS=","; read -a ARR2 <<< "$tags"; IFS=";"
			for ((i=0;i<${#ARR2[@]}; i++))
			do
				tag=${ARR2[$i]}
				((TAGAARR[$tag]++))
				echo "$tag">>/tmp/proxmox/tags.csv
			done
		fi
	done < data_node_$1.csv
}


#================================================================
# Finds the ratio of local storage used, called for every node
function GetLocalStorage()
{
	if [ "$DEBUG" = "Y" ]; then echo "FUNCTION $FUNCNAME -$1-" >>debug.log ; fi

	ApiCall GET /api2/json/nodes/$1/storage
#	echo "response=$response"
	jq '.data[]' <<<$response >/tmp/proxmox/storage_$1.json

	jq -r '.storage + ";"+ (.used_fraction|tostring) + ";" + (.used|tostring)' /tmp/proxmox/storage_$1.json >/tmp/proxmox/storage_$1.csv
	IFS=";"; while read -a ARRSTO
	do
		if [ "${ARRSTO[0]}" = "local" ]; then
			STOR_RATIO=${ARRSTO[1]}
		fi
		if [ "${ARRSTO[0]}" = "$CEPH_HDD_NAME" ] || [ "${ARRSTO[0]}" = "$CEPH_SSD_NAME" ]; then
			echo "${ARRSTO[0]};${ARRSTO[1]}" >>/tmp/proxmox/data_storage_ceph.csv
		fi
	done </tmp/proxmox/storage_$1.csv

# we only need the first 2, the others are redundant
	head -n 2 /tmp/proxmox/data_storage_ceph.csv >data_storage_ceph.csv
}

#================================================================
# Called for every node
function GetCPULoad()
{
	if [ "$DEBUG" = "Y" ]; then echo "FUNCTION $FUNCNAME -$1-" >>debug.log ; fi

	IFS=";"; while read -a ARRLOAD
	do
		if [ "${ARRLOAD[0]}" = "$1" ]; then
			CPULOAD=${ARRLOAD[1]}
		fi
	done </tmp/proxmox/node_load.csv
	CPULOAD=$(bc <<< $CPULOAD*100)

if [ "$DEBUG" = "Y" ]; then echo "GetCPULoad(): CPULOAD=$CPULOAD" >>debug.log; fi
}

#================================================================
# Fetch all the data
# This function does not print anything
function FetchData()
{
	if [ "$DEBUG" = "Y" ]; then echo "FUNCTION $FUNCNAME" >>debug.log ; fi

	echo "Gathering data, please wait..."
# clean out old data
	rm /tmp/proxmox/* 2>/dev/null
	rm data_* 2>/dev/null
	TAGAARR=()

# Fetch list of nodes
	ApiCall GET "/api2/json/nodes"
	jq  -r '.data[] | .node' <<<"$response" >/tmp/proxmox/data_nodes.csv 2>>$CURLLOG
	sort /tmp/proxmox/data_nodes.csv >/tmp/proxmox/data_nodes2.csv

# get CPU load of each node
	jq -r '.data[] | (.node + ";" + (.cpu|tostring) + ";" + (.mem|tostring) + ";" + (.maxmem|tostring))' <<< "$response" >/tmp/proxmox/node_load.csv

# add percentage of local storage used
	while read NODE
	do
		GetLocalStorage $NODE
		GetCPULoad $NODE
		printf "%s;%.3f;%.3f\n" $NODE $STOR_RATIO $CPULOAD >>data_nodes.csv
	done </tmp/proxmox/data_nodes2.csv

	NB_NODES=$(wc -l <data_nodes.csv)
#	echo "NB_NODES=$NB_NODES"

	NODEARR=()
# Main API loop, iterate on all nodes and collect all the nodes data
	IFS=";"; while read -a ARRN
	do
		NODE=${ARRN[0]}
		NODEARR+=($NODE)

# step 1: fetch all the machines on that node
		ProcessNode $NODE

# step 1bis: create one data file per VM
		IFS=";"; while read -a TAB
		do
			echo "${TAB[0]};${TAB[2]}" >data/vmid/id_${TAB[1]}
		done < data_node_ALL.csv

# step 2: build data file holding templates
		IFS=";"; while read -a ARR
		do
#			echo "$NODE: ${ARR[1]};${ARR[2]};${ARR[0]}"
			if [ "${ARR[3]}" = "1" ]; then
#				((NBT++))
				echo "${ARR[1]};${ARR[2]};${ARR[0]}" >> data_template_$NODE.csv
				echo "$NODE;${ARR[1]};${ARR[2]};${ARR[0]}" >> data_template_ALL.csv
			fi
		done <data_node_$NODE.csv
	done <data_nodes.csv

	sort /tmp/proxmox/tags.csv >/tmp/proxmox/tags1.csv
	uniq /tmp/proxmox/tags1.csv >data_tags.csv

	TAGARR=()
	IFS=";"; while read TAG
	do
		TAGARR+=($TAG)
	done <data_tags.csv

# Generate a csv file for each tag, holding the node, the VMID, the name, type (Vm:0/T:1) (in that order)
# The file holds the tags, because a machine can hold several tags so it may be useful to show all the tags assigned
	IFS=";"; while read -a TAG
	do
		while read -a ARR
		do
	#		echo "ARR[3]=${ARR[3]}"
			tags=${ARR[3]}
			IFS=","; read -a ARR2 <<< "$tags"; IFS=";"
			for i in ${ARR2[@]}
			do
				if [ "$i" = "$TAG" ]; then
					fname=data_tag_$TAG
#					if [ "$TAG" = " " ]; then fname=data_tag_NOTAG; fi
					echo "${ARR[0]};${ARR[1]};${ARR[2]};${ARR[4]};${ARR[3]};${ARR[5]};${ARR[6]};${ARR[7]};${ARR[8]}" >>$fname.csv
				fi
			done
		done <data_node_ALL.csv
	done <data_tags.csv

# Generate a csv file for each group, holding the users
	ApiCall GET "/api2/json/access/users?full=1"
	jq -r '.data[]' <<<$response >/tmp/proxmox/users.json

# convert json into 3-fields CSV file
	jq -r '.userid + ";" + .groups + ";" + .email'</tmp/proxmox/users.json >/tmp/proxmox/users.csv

	sort /tmp/proxmox/users.csv >data_users.csv
	#echo -e "\n-Nb utilisateurs enregistrés: $(wc -l<data_users.csv) "

	# build one file per group
	rm data_group_*.csv 2>/dev/null

	if [ -f /tmp/proxmox/groups1.csv ]; then rm /tmp/proxmox/groups1.csv; fi
	IFS=";"; while read -a TAB
	do
		GR=${TAB[1]}
		echo "$GR">>/tmp/proxmox/groups1.csv
		if ! [ "$GR" = "" ]; then
			echo "${TAB[0]};${TAB[2]}" >> data_group_${GR}.csv
		else
			echo "${TAB[0]};${TAB[2]}" >> data_group_NOGROUP.csv
		fi
	done <data_users.csv

	sort /tmp/proxmox/groups1.csv >/tmp/proxmox/groups2.csv
	uniq /tmp/proxmox/groups2.csv >data_groups.csv
}


