#================================================================
# Start or Stop all VMs having a given tag
function StartStop()
{
	if [ "$DEBUG" = "Y" ]; then echo "FUNCTION $FUNCNAME" >>debug.log ; fi

	VTAG=$(zenity --list --height=300 --text="What tag?" --column="Tags" "${TAGARR[@]}")
	if [ $? != 0 ]; then
		echo "Cancel"; return 1
	fi
	ACTION=$(zenity --list --text="Start, Stop, or immediate shutdown?" --column="Action" "Start" "Stop" "Shutdown")
	if [ $? != 0 ]; then
		echo "Cancel"; return 1
	fi

	if ! [ -f data_tag_$VTAG.csv ]; then
		echo "Error, file data_tag_$VTAG.csv missing!"; exit 1
	fi

	COUNT=0
	IFS=";"; while read -a TAB
	do
		if [ ${TAB[3]} == 0 ]; then
			if [ "${TAB[5]}" == "running" ]; then
				((COUNT++))
			fi
		fi
	done <data_tag_$VTAG.csv
	echo "Nb of related VM: $COUNT"

	if [ $COUNT != 0 ]; then
		MSG="stop"
		if [ "$ACTION" = "Start" ]; then
			MSG="start"
		fi
		START=$(zenity --question --text "Ok to $MSG $COUNT VMs?")
		if [ $? = 0 ]; then
			IFS=";"; while read -a TAB
			do
				if [ ${TAB[3]} == 0 ]; then
					NODE=${TAB[0]}
					VMID=${TAB[1]}
					echo "${ACTION}ing VM n°$VMID named ${TAB[2]}, running on node $NODE" | tee -a $LOGFILE
					if [ "$ACTION" = "Stop" ]; then
						ApiCall POST "/api2/json/nodes/$NODE/qemu/$VMID/status/shutdown?forceStop=1"
					else
						ApiCall POST "/api2/json/nodes/$NODE/qemu/$VMID/status/start"
					fi
				fi
			done <data_tag_$VTAG.csv
		fi
	fi
}


#================================================================
function CreateVmSet()
{
	if [ "$DEBUG" = "Y" ]; then echo "FUNCTION $FUNCNAME" >>debug.log ; fi

# --------------------------------
# Step 1 - zenity dialogs
# --------------------------------

DONE=NO
while [ $DONE = NO ]
do
	BASENODE=$(zenity --list --text="Select node on which is the\ntemplate" --column="Nodes" ${NODEARR[@]})
	if [ $? != 0 ]; then
		echo "Cancel"; return 1
	fi

#	echo "BASENODE=$BASENODE"

	if ! [ -f data_template_$BASENODE.csv ]
	then
		echo "No template available on node '$BASENODE'!"
	else
		DONE=YES
	fi
done

# construction chaine contenant les noms des templates
unset TEMPLATES
declare -a TEMPLATES
IFS=";"; while read -a ARR
do
#	echo "TEMPLATES=$TEMPLATES ARR[0]=${ARR[0]}"
	x=${ARR[0]}
	TEMPLATES+=($x)
done < data_template_$BASENODE.csv

#echo "t=${TEMPLATES[@]}"

TEMPLATE=$(zenity --list --text="Which template?" --column="Templates" ${TEMPLATES[@]})
if [ $? != 0 ]; then
	echo "Cancel"; return 1
fi
#echo "TEMPLATE=$TEMPLATE"

# récupération du vmid du template
IFS=";"; while read -a ARR
do
	if [ ${ARR[0]} = $TEMPLATE ]
	then
		TVMID=${ARR[2]}
	fi
done < data_template_$BASENODE.csv

#echo "TVMID=$TVMID"

DONE=NO
while [ $DONE = NO ]
do
	MOD=$(zenity --entry --text "Enter root VM name (RXXX, SAETTT)")
	if [ $? != 0 ]; then
		echo "Cancer"; return 1
	fi
	if [ ${#MOD} = 0 ]; then
		echo "Error, cannot be empty!"
	else
		DONE=YES
	fi
done

#echo "MOD=$MOD"


DONE=NO
while [ $DONE = NO ]
do

	TAGS=$(zenity --entry --text "Enter tags, comma separated\nno space in the tags!)")
	if [ $? != 0 ]; then
		echo "Cancel"; return 1
	fi
	echo "TAGS=$TAGS"
	if [ ${#TAGS} = 0 ]; then
		echo "Error, give at least one tag!"
	else
		DONE=YES
	fi
done

# Generate a 2 character random id for the VmId
YEARDAY=$(date '+%y%j')
DONE=NO
NUMID=00
while [ $DONE = NO ]
do
	N1=$(shuf -i 0-99 -n 1)
	NUMID=$N1
	if [ 1 = ${#N1} ]; then NUMID="0$N1";fi

# check that the VM Id is not already used
	VMID=${YEARDAY}${NUMID}01
	NOGOOD=false
	IFS=";"; while read -a ARR
	do
		if [ ${ARR[1]} = $VMID ]; then
