# Show list of VM holding a given tag
function ViewVmByTag()
{
	# re-create an array holding the tag names
	unset TAGARR
	declare -a TAGARR
	while read -r tagname
	do
		TAGARR+=($tagname)
	done < data_tags.csv

	VTAG=$(zenity --list --height=300 --text="Quel tag?" --column="Tags" "${TAGARR[@]}")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	if [ "$DEBUG" = "N" ]; then clear; fi
	echo -e "\n-Liste des $(wc -l<data_tag_$VTAG.csv) machines ayant le tag '$VTAG':"
	printf "| VM/T |      Node     |       Nom       |    VMId     |      Tags       |\n";
	printf "|------+---------------+-----------------+-------------+-----------------|\n"

	IFS=";";while read -a TAB
	do
		if [ ${TAB[3]} == 1 ]; then
			printf "|  T   |"
		else
			printf "|  VM  |"
		fi
		printf " %-13s | %-15s | %11d | %15s |\n" ${TAB[0]} ${TAB[2]} ${TAB[1]} ${TAB[4]} 
	done <data_tag_$VTAG.csv
	printf "|------+---------------+-----------------+-------------+-----------------|\n"
}


#================================================================
# Show list of users in a given group
function ViewGroups()
{
# create an array holding the group names, just for the zenity call below
	unset GROUPARR
	declare -a GROUPARR
	while read -r group
	do
		GROUPARR+=($group)
	done < data_groups.csv

	GROUPARR+=("(Sans groupe)")

	GROUP=$(zenity --list --height=300 --text="Quel groupe?" --column="groupes" "${GROUPARR[@]}")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	#echo "GROUP=$GROUP"
	if [ "$GROUP" = "(Sans groupe)" ]; then
		GROUPFILE=data_group_NOGROUP.csv
	else
		GROUPFILE=data_group_$GROUP.csv
	fi

	if [ "$DEBUG" = "N" ]; then clear; fi
	GROUPSIZE=$(wc -l <$GROUPFILE)
	echo "-Groupe '$GROUP': $GROUPSIZE utilisateurs"

	printf "|       Id       |                   email                  |\n";
	printf "|----------------+------------------------------------------|\n"

	IFS=";";while read -a TAB
	do
		printf "| %14s | %-40s |\n" ${TAB[0]} ${TAB[1]}
	done <$GROUPFILE
	printf "|----------------+------------------------------------------|\n"
}


#================================================================
# Show list of VM on a given node
function ViewVmByNode()
{
# re-create an array holding the nodes names
	unset NODEARR
	declare -a NODEARR
	while read -r nodename
	do
		NODEARR+=($nodename)
	done < data_nodes.csv

	VNODE=$(zenity --list --text="Quel node?" --column="node" "${NODEARR[@]}")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	if ! [ "$DEBUG" = "N" ]; then clear; fi
	echo -e "\n-Liste des $(wc -l<data_node_$VNODE.csv) machines du node '$VNODE':"
	printf "| VM/T |    |        Nom       |    VMId    |     Tags      |\n";
	printf "|------+----+------------------+------------+---------------|\n"
	NBON=0
	IFS=";";while read -a TAB
	do
		if [ ${TAB[3]} == 1 ]; then
			printf "|  T   | - "
		else
			printf "|  VM  | "

			if [ ${TAB[4]} = "stopped" ]; then
				echo -n "🔴"
			else
				echo -n "🟢"
				((NBON++))
			fi
		fi
		printf " | %-16s | %10d | %13s |\n" ${TAB[1]} ${TAB[0]} ${TAB[2]}
	done <data_node_$VNODE.csv
	printf "|------+----+------------------+------------+---------------|\n"

	NBT=0
	if [ -f data_template_$VNODE.csv ]; then
		NBT=$(wc -l <data_template_$VNODE.csv)
	fi

	NBTOT=$(wc -l <data_node_$VNODE.csv)
	((NBVM=NBTOT-NBT))
	echo "Bilan: $NBT templates et $NBVM VM, dont $NBON en fonctionnement"
}

