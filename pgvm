# Check that file holding credentials is there
if ! [ -f $TOKEN_FILE ];
then
	echo "Erreur, fichier '$TOKEN_FILE' introuvable!"
	exit 1
fi
source $TOKEN_FILE

# TODO: this will be useless once all the code will be in a single file
export PVUSER
export TOK_VALUE
export TOK_NAME
export REALM
export CURLLOG
export APINODE
export DOMAIN
export PORT


#================================================================
function DeleteVm()
{
if ! [ -f data_tags.csv ]
then
	echo "Erreur, fichier 'data_tags.csv' inaccessible"
	exit 1
fi

declare -a TAGARR
IFS=";";while read TAG
do
	TAGARR+=($TAG)
done <data_tags.csv
#echo "TAGARR=${TAGARR[@]}"	

TAGDEL=$(zenity --list --text="Quel machines ayant le tag ci-dessous souhaitez-vous détruire?" --column="tags" ${TAGARR[@]})
if [ $? != 0 ]; then
	echo "Interruption"; exit 1
fi

# count VM only (not templates, as these will not be deleted)
#echo "TAGDEL=$TAGDEL"
COUNT=0
IFS=";";while read -a ARR
do
	if [ ${ARR[3]} = 0 ]; then ((COUNT++)); fi
done < data_tag_${TAGDEL}.csv

START=$(zenity --question --text \
	"Ok pour effacer les ${COUNT} VMs associées au tag $TAGDEL?")

if [ $? != 0 ]; then
	echo "Interruption"; exit 1
fi
#echo "START=$START"
#exit 1

#-------------------------
# Delete VMs
# TODO: pas plus simple de lire dans le fichier tags_XXXX.csv ???

set +x
COMPT=0
IFS=";";while read -a TAB
do
	if ! [ "${TAB[3]}" = "" ]; then
		IFS=","; read -r -a TAGS <<< "${TAB[3]}"; IFS=";"
		for ((i=0; i<${#TAGS[@]}; i++))
		do
			tag=${TAGS[$i]}
#				echo "node ${TAB[0]}: machine ${TAB[2]}, tag=$tag"
			if [ $tag = $TAGDEL ]; then
				if [ "${TAB[4]}" = "1" ]; then
					echo "node ${TAB[0]}: machine ${TAB[2]}, id=${TAB[1]} est un template, pas de suppression"
				else
					echo "node ${TAB[0]}: suppression machine ${TAB[2]}, id=${TAB[1]}"
					response=$(curl --insecure --silent -X DELETE \
						-H "Authorization: PVEAPIToken=${PVUSER}@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
						"https://${APINODE}.${DOMAIN}:${PORT}/api2/json/nodes/${TAB[0]}/qemu/${TAB[1]}?node=${TAB[0]}&vmid=${TAB[1]}")
					err=$?

					if [ $err != 0 ]; then
						echo "Error: failure of delete operation, err=$err, response='$response'";
						exit 1
					fi
					((COMPT++))
				fi
			fi
		done
	fi
done <data_out_all.csv

echo "-$COMPT VM supprimées, appuyer sur une touche"
read
}


#================================================================
function ViewTags()
{
# re-create an array holding the tag names
declare -a TAGARR
while read -r tagname
do
	TAGARR+=($tagname)
done < data_tags.csv

VTAG=$(zenity --list --height=300 --text="Quel tag?" --column="Tags" "${TAGARR[@]}")
if [ $? != 0 ]; then
	echo "Interruption"; exit 1
fi

if [ "$DEBUG" = "N" ]; then clear; fi
echo -e "\n-Liste des $(wc -l<data_tag_$VTAG.csv) machines ayant le tag '$VTAG':"
printf "| VM/T |      Node     |       Nom       |    VMId     |      Tags       |\n";
printf "|------+---------------+-----------------+-------------+-----------------|\n"

IFS=";";while read -a TAB
do
	if [ ${TAB[3]} == 1 ]; then
		printf "|  T   |"
	else
		printf "|  VM  |"
	fi
	printf " %-13s | %-15s | %11d | %15s |\n" ${TAB[0]} ${TAB[2]} ${TAB[1]} ${TAB[4]} 
done <data_tag_$VTAG.csv
printf "|------+---------------+-----------------+-------------+-----------------|\n"
}


#================================================================
