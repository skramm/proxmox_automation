# args: $1 disk (HDD/SSD), $2 clone type (FC/LC), $3 base VM ID, in case of Linked Clone
function PrintDiskCloneType()
{
	CT=$2
	printf "  %3s |  %2s  |" $1 $CT
	if [ "$1" == "HDD" ]; then ((NBHDD++)); fi
	if [ "$1" == "SSD" ]; then ((NBSSD++)); fi

# print disk VM Id for linked clone
		if [ "$CT" == "FC" ]; then
			printf "        -         "
		else
			printf "  %6d" $3
			IFS=";"; while read -a TAB2
			do
				printf "/%-9s" ${TAB2[0]}
			done < data/vmid/id_$3
		fi
		echo " |"
}

