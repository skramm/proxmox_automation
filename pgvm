# Delete a set of VM holding a given tag
function DeleteVmByTag()
{
	if ! [ -f data_tags.csv ]
	then
		echo "Erreur, fichier 'data_tags.csv' inaccessible"
		exit 1
	fi

	unset TAGARR
	declare -a TAGARR
	IFS=";";while read TAG
	do
		TAGARR+=($TAG)
	done <data_tags.csv
	#echo "TAGARR=${TAGARR[@]}"	

	TAGDEL=$(zenity --list --height=300 \
		--text="Quel machines ayant le tag ci-dessous souhaitez-vous détruire?" --column="tags" ${TAGARR[@]})
