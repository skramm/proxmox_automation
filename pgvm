#!/bin/bash

# name: pgvm ("Proxmox Gestion VM")
# S. Kramm, URN, 2026

#TOKEN_FILE=../token_20260110

if [ "$1" = "" ]
then
	echo "Erreur, donner en argument le fichier de credentials"
	exit 1
fi
TOKEN_FILE=$1

# vérification de l'accès au fichier
if ! [ -f $TOKEN_FILE ];
then
	echo "Erreur, fichier $TOKEN_FILE introuvable!"
	exit 1
fi
source $TOKEN_FILE

export PVUSER
export TOK_VALUE
export TOK_NAME
export REALM
export CURLLOG


# vérification que zenity est installé
which zenity >/dev/null
if [ $? = 1 ]
then
	echo "Erreur: zenity pas disponible"
	exit 1
fi

TODAY=$(date '+%Y%m%d_%H%M%S')
CURLLOG=/tmp/proxmox/curl_$TODAY.log

# on stocke les logs de curl la bas
mkdir -p /tmp/proxmox

# test de la réponse de l'API
echo "Test de la réponse de l'API"

response=$(curl --silent -k \
  -H "Authorization: PVEAPIToken=$PVUSER@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
  https://anvers.univ-rouen.fr:8006/api2/json/version) 1>>$CURLLOG

if [ $? -eq 0 ] && [ -n "$response" ]; then
    echo "API disponible"
else
    echo "API indisponible, réponse='$response'"
	exit 1
fi


items=("Liste VM" "Création VMs" "Suppression VMs")

while item=$(zenity --list \
	--title="Menu principal" \
	--text="Choix" \
	--column="Options" "${items[@]}")
do
if [ $? != 0 ]; then
	echo "Interruption"; exit 1
fi

echo "item=$item"

case "$item" in
	"${items[0]}") ./pgvm_list;;
	"${items[1]}") ./pgvm_create;;
	"${items[2]}") ./pgvm_delete;;
	*) echo "Ooops! Invalid option.";;
esac
done

echo "fini!"


