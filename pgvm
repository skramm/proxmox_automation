function ShowTags()
{
	COMPT=0
	TOT_VM=0
	TOT_T=0
	printf "\n|   %2d Tags  | #VM+T | #VM |  #T |\n|------------+-------+-----+-----|\n" $(wc -l <data_tags.csv)
	while read TAG
	do
		GetType $TAG
