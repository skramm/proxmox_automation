#================================================================
# Start or Stop all VMs having a given tag
function StartStop()
{
	VTAG=$(zenity --list --height=300 --text="Quel tag?" --column="Tags" "${TAGARR[@]}")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi
	ACTION=$(zenity --list --text="Start ou Stop?" --column="Action" "Start" "Stop")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	if ! [ -f data_tag_$VTAG.csv ]; then
		echo "Erreur, fichier data_tag_$VTAG.csv introuvable !"; exit 1
	fi

	COUNT=0
	IFS=";"; while read -a TAB
	do
		if [ ${TAB[3]} == 0 ]; then
			if [ "${TAB[5]}" == "running" ]; then
				((COUNT++))
			fi
		fi
	done <data_tag_$VTAG.csv

	MSG="arrêter"
	if [ "$ACTION" = "Start" ]; then
		MSG="démarrer"
	fi

	START=$(zenity --question --text "Ok pour $MSG $COUNT VMs?")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	IFS=";"; while read -a TAB
	do
		if [ ${TAB[3]} == 0 ]; then
			NODE=${TAB[0]}
			VMID=${TAB[1]}
			if [ "$ACTION" = "Stop" ]; then
				echo "Arret de la VM n°$VMID"
				ApiCall POST "/api2/json/nodes/$NODE/qemu/$VMID/status/shutdown?forceStop=1"
			else
				echo "Démarrage de la VM n°$VMID"
				ApiCall POST "/api2/json/nodes/$NODE/qemu/$VMID/status/start"
			fi
		fi
	done <data_tag_$VTAG.csv
}


