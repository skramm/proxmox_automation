#================================================================
# Fetch data of a given node ($1), called by FetchData()
function ProcessNode()
{
	if [ "$DEBUG" = "Y" ];then echo "ProcessNode(): $1"; fi
	
	curl --insecure --silent -X GET \
		-H "Authorization: PVEAPIToken=$PVUSER@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		https://${APINODE}.${DOMAIN}:${PORT}/api2/json/nodes/$1/qemu?full=1 | jq -r '.data[]' >/tmp/proxmox/node_$1.json 2>>$CURLLOG
	err=$?
	if ! [ $err = 0 ]
	then
		echo "node '$1': echec!"
		exit 1
	fi
# we use the '_' character to separate fields because in the json file, multiple tags are separated with ';'
# (and '_' is not allowed in the VM name field)
	jq -r '(.vmid|tostring) + "_" + .name + "_" + .tags + "_" + (.template|tostring) + "_" + .status' < /tmp/proxmox/node_$1.json >/tmp/proxmox/node_$1.csv

# replace null by 0 (machine is not a template), just to make it prettier
	sed -i -e 's/_null/_0/g' /tmp/proxmox/node_$1.csv

# replace the semi-colon separating tags with a comma
	sed -i -e 's/;/,/g' /tmp/proxmox/node_$1.csv

# replace the underscore by semi-colon
	sed -i -e 's/_/;/g' /tmp/proxmox/node_$1.csv

# sort by name
	sort --key=1 /tmp/proxmox/node_$1.csv >data_node_$1.csv
	
# Add node name on each line, first position
	IFS=";";while read line;
	do
		echo "$1;${line}" >> data_node_ALL.csv
 	done < data_node_$1.csv

	# extraction des template de chaque node

#	NBT=0
#	rm template_$1.csv 2>/dev/null
	IFS=";";while read -a ARR
	do
		echo "0:${ARR[0]} - 1:${ARR[1]} - 2:${ARR[2]} - 3:${ARR[3]}"
#		if [ ${ARR[3]} = 1 ]
#		then
#			NBT=$((NBT+1))
#			echo "${ARR[1]};${ARR[2]};${ARR[0]}" >> data_template_$1.csv
#			echo "$1;${ARR[1]};${ARR[2]};${ARR[0]}" >> data_template_ALL.csv
#		fi

# comptage du nb d'occurrence pour chaque tag
# TODO: supprimer quand on aura les csv par tag
		if ! [ "${ARR[2]}" = "" ]
		then
			tags=${ARR[2]}
		echo "ProcessNode(): tags=$tags"
			IFS=","; read -a ARR2 <<< "$tags"; IFS=";"
			for ((i=0;i<${#ARR2[@]}; i++))
			do
				tag=${ARR2[$i]}
				((TAGAARR[$tag]++))
				echo "$tag">>/tmp/proxmox/tags.csv
			done
		fi
	done < data_node_$1.csv
	echo "tags.csv size=$(wc -l </tmp/proxmox/tags.csv)"
}


#================================================================
# Fetch all the data
# This function does not print anything
function FetchData()
{
	if [ "$DEBUG" = "Y" ]; then echo "FetchData()"; fi

# clean out old data
	rm /tmp/proxmox/tags.csv 2>/dev/null
	rm data_* 2>/dev/null
	
# Fetch list of nodes
	curl --silent -k \
		-H "Authorization: PVEAPIToken=$PVUSER@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		https://${APINODE}.${DOMAIN}:${PORT}/api2/json/nodes|jq | jq -r '.data[] | .node' >data_nodes.csv 2>>$CURLLOG
	err=$?
	if ! [ $err = 0 ];
	then
		echo "Error: API call failure, err=$?"
		exit 1
	fi
	echo "data_nodes.csv: $(cat data_nodes.csv)"

# Main API loop, iterate on all nodes and collect all the nodes data
	while read -r NODE
	do
# step 1: fetch all the machines on that node
		ProcessNode $NODE

# step 2: build data file holding templates
		IFS=";"; while read -a ARR
		do
			echo "0:${ARR[0]} - 1:${ARR[1]} - 2:${ARR[2]} - 3:${ARR[3]}"
			if [ ${ARR[3]} = 1 ]; then
				((NBT++))
				echo "${ARR[1]};${ARR[2]};${ARR[0]}" >> data_template_$NODE.csv
				echo "$NODE;${ARR[1]};${ARR[2]};${ARR[0]}" >> data_template_ALL.csv
			fi
		done < data_node_$NODE.csv

	done <data_nodes.csv

	sort /tmp/proxmox/tags.csv >/tmp/proxmox/tags1.csv
	uniq /tmp/proxmox/tags1.csv >data_tags.csv

# Generate a csv file for each tag, holding the type (Vm/T), the VMID, the name, and the node
	IFS=";";while read -a TAG
	do
		echo "FetchData(): TAG=$TAG"
		while read -a ARR
		do
	#		echo "ARR[3]=${ARR[3]}"
			tags=${ARR[3]}
			IFS=","; read -a ARR2 <<< "$tags"; IFS=";"
			for i in ${ARR2[@]}
			do
				if [ "$i" = "$TAG" ]; then
					echo "${ARR[0]};${ARR[1]};${ARR[2]};${ARR[4]};${ARR[3]}" >>data_tag_$TAG.csv
				fi
			done
		done <data_node_ALL.csv
	done <data_tags.csv

# Generate a csv file for each group, holding the users
	curl --insecure --silent -X GET \
		-H "Authorization: PVEAPIToken=${PVUSER}@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		"https://${APINODE}.${DOMAIN}:${PORT}/api2/json/access/users?full=1" | jq '.data[]' >/tmp/proxmox/users.json
	err=$?
	if [ $err != 0 ]; then
		echo "Error: failure of operation, err=$err";
		exit 1
	fi

# convert json into 3-fields CSV file
	jq -r '.userid + ";" + .groups + ";" + .email'</tmp/proxmox/users.json >/tmp/proxmox/users.csv

	sort /tmp/proxmox/users.csv >data_users.csv
	#echo -e "\n-Nb utilisateurs enregistrés: $(wc -l<data_users.csv) "

	# build one file per group
	rm data_group_*.csv 2>/dev/null

#	declare -A NBUSGR

	if [ -f /tmp/proxmox/groups1.csv ]; then rm /tmp/proxmox/groups1.csv; fi
	IFS=";";while read -a TAB
	do
		GR=${TAB[1]}
		echo "$GR">>/tmp/proxmox/groups1.csv
		if ! [ "$GR" = "" ]; then
			echo "${TAB[0]};${TAB[2]}" >> data_group_${GR}.csv
		else
			echo "${TAB[0]};${TAB[2]}" >> data_group_NOGROUP.csv
		fi
	done <data_users.csv

	sort /tmp/proxmox/groups1.csv >/tmp/proxmox/groups2.csv
	uniq /tmp/proxmox/groups2.csv >data_groups.csv
}


#================================================================
function ShowNodes()
{
	echo "|    Node    | #VM | #Templ. |  Tot  |"
	echo "|------------+-----+---------+-------|"

	TOTVM=0
	TOTT=0
	TOTALL=0

	while read -r NODE
	do
		NBTOT=$(wc -l <data_node_$NODE.csv)
		NBT=$(wc -l <data_template_$NODE.csv)
		
		((NBVM=NBTOT-NBT))
		printf "| %10s | %3d | %7d | %5d |\n" $NODE $NBVM $NBT $NBTOT
		((TOTVM+=NBVM))
		((TOTT+=NBT))
		((TOTALL+=NBTOT))
	done < data_nodes.csv

	echo "|------------+-----+---------+-------|"
	printf "      Totaux | %3d | %7d | %5d |\n" $TOTVM $TOTT $TOTALL
}

#================================================================
function ShowTemplates()
{
	echo -e "\n-Liste des $(wc -l<data_template_ALL.csv) templates:"
	printf "| %12s | %13s | %15s | %7s |\n" Node Name Tags VMid
	echo "|--------------+---------------+-----------------+---------|"
	IFS=";";while read -a ARR
	do
		printf "| %12s | %13s | %15s | %7s |\n" ${ARR[0]} ${ARR[1]} ${ARR[2]} ${ARR[3]}
	done < data_template_ALL.csv
	echo "|--------------+---------------+-----------------+---------|"
}

#================================================================
function ShowTags()
{
	COMPT=0
	printf "\n|   %2d Tags  | #VM+T. |\n|------------+--------|\n" $(wc -l <data_tags.csv)
	NUM=1
	for i in "${!TAGAARR[@]}"
	do
		printf "| %10s | %6d |\n" $i ${TAGAARR[$i]}
		((COMPT+=${TAGAARR[$i]}))
		((NUM++))
	done
	echo "|------------+--------|"
	printf "       Total | %6d |\n" $COMPT
	echo "total=$(wc -l <data_tags.csv)"
}

#================================================================
function ShowGroups()
{
	echo -e "\n-Nb d'utilisateurs: $(wc -l <data_users.csv), répartis dans $(wc -l <data_groups.csv) groupes"
	echo -e "|         Group           | #Users |\n|-------------------------+--------|"
	COMPT=0
	IFS=";";while read groupname
	do
		if ! [ "$groupname" = "" ]; then
			nb=$(wc -l <data_group_${groupname}.csv)
			printf "| %23s | %6d |\n" $groupname $nb
			((COMPT+=nb))
		fi
	done <data_groups.csv

	NBNOGROUP=$(wc -l <data_group_NOGROUP.csv)
	printf "|           (no group)    | %6d |\n" $NBNOGROUP
	((COMPT+=NBNOGROUP))
	echo "|-------------------------+--------|"
	printf "                  Total   | %6d |\n" $COMPT
}

#================================================================
function ShowDashboard()
{
	ShowNodes
	ShowTemplates
	ShowTags
	ShowGroups
}

#================================================================
# Delete a set of VM holding a given tag
function DeleteVm()
{
	if ! [ -f data_tags.csv ]
	then
		echo "Erreur, fichier 'data_tags.csv' inaccessible"
		exit 1
	fi

	declare -a TAGARR
	IFS=";";while read TAG
	do
		TAGARR+=($TAG)
	done <data_tags.csv
	#echo "TAGARR=${TAGARR[@]}"	

	TAGDEL=$(zenity --list --text="Quel machines ayant le tag ci-dessous souhaitez-vous détruire?" --column="tags" ${TAGARR[@]})
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

# count VM only (not templates, as these will not be deleted)
#echo "TAGDEL=$TAGDEL"
	COUNT=0
	IFS=";";while read -a ARR
	do
		if [ ${ARR[3]} = 0 ]; then ((COUNT++)); fi
	done < data_tag_${TAGDEL}.csv

	zenity --question --text \
		"Ok pour effacer les ${COUNT} VMs associées au tag $TAGDEL?"
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi


#-------------------------
# Delete VMs
# TODO: pas plus simple de lire dans le fichier tags_XXXX.csv ???

COMPT=0
IFS=";";while read -a TAB
do
	if ! [ "${TAB[3]}" = "" ]; then
		IFS=","; read -r -a TAGS <<< "${TAB[3]}"; IFS=";"
		for ((i=0; i<${#TAGS[@]}; i++))
		do
			tag=${TAGS[$i]}
#				echo "node ${TAB[0]}: machine ${TAB[2]}, tag=$tag"
			if [ $tag = $TAGDEL ]; then
				if [ "${TAB[4]}" = "1" ]; then
					echo "node ${TAB[0]}: machine ${TAB[2]}, id=${TAB[1]} est un template, pas de suppression"
				else
					echo "node ${TAB[0]}: suppression machine ${TAB[2]}, id=${TAB[1]}"
					response=$(curl --insecure --silent -X DELETE \
						-H "Authorization: PVEAPIToken=${PVUSER}@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
						"https://${APINODE}.${DOMAIN}:${PORT}/api2/json/nodes/${TAB[0]}/qemu/${TAB[1]}?node=${TAB[0]}&vmid=${TAB[1]}")
					err=$?

					if [ $err != 0 ]; then
						echo "Error: failure of delete operation, err=$err, response='$response'";
						exit 1
					fi
					((COMPT++))
				fi
			fi
		done
	fi
done <data_node_ALL.csv

echo "-$COMPT VM supprimées, appuyer sur une touche"
read
}


#================================================================
# Show list of VM holding a given tag
function ViewVmTag()
{
	# re-create an array holding the tag names
	declare -a TAGARR
	while read -r tagname
	do
		TAGARR+=($tagname)
	done < data_tags.csv

	VTAG=$(zenity --list --height=300 --text="Quel tag?" --column="Tags" "${TAGARR[@]}")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	if [ "$DEBUG" = "N" ]; then clear; fi
	echo -e "\n-Liste des $(wc -l<data_tag_$VTAG.csv) machines ayant le tag '$VTAG':"
	printf "| VM/T |      Node     |       Nom       |    VMId     |      Tags       |\n";
	printf "|------+---------------+-----------------+-------------+-----------------|\n"

	IFS=";";while read -a TAB
	do
		if [ ${TAB[3]} == 1 ]; then
			printf "|  T   |"
		else
			printf "|  VM  |"
		fi
		printf " %-13s | %-15s | %11d | %15s |\n" ${TAB[0]} ${TAB[2]} ${TAB[1]} ${TAB[4]} 
	done <data_tag_$VTAG.csv
	printf "|------+---------------+-----------------+-------------+-----------------|\n"
}


#================================================================
# Show list of users in a given group
function ViewGroups()
{
# create an array holding the group names, just for the zenity call below
	declare -a GROUPARR
	while read -r group
	do
		GROUPARR+=($group)
	done < data_groups.csv

	GROUPARR+=("(Sans groupe)")

	GROUP=$(zenity --list --height=300 --text="Quel groupe?" --column="groupes" "${GROUPARR[@]}")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	#echo "GROUP=$GROUP"
	if [ "$GROUP" = "(Sans groupe)" ]; then
		GROUPFILE=data_group_NOGROUP.csv
	else
		GROUPFILE=data_group_$GROUP.csv
	fi

	if [ "$DEBUG" = "N" ]; then clear; fi
	GROUPSIZE=$(wc -l <$GROUPFILE)
	echo "-Groupe '$GROUP': $GROUPSIZE utilisateurs"

	printf "|       Id       |                   email                  |\n";
	printf "|----------------+------------------------------------------|\n"

	IFS=";";while read -a TAB
	do
		printf "| %14s | %-40s |\n" ${TAB[0]} ${TAB[1]}
	done <$GROUPFILE
	printf "|----------------+------------------------------------------|\n"
}


#================================================================
# Show list of VM on a given node
function ViewVM()
{
# re-create an array holding the nodes names
	declare -a NODEARR
	while read -r nodename
	do
		NODEARR+=($nodename)
	done < data_nodes.csv

	VNODE=$(zenity --list --text="Quel node?" --column="node" "${NODEARR[@]}")
	if [ $? != 0 ]; then
		echo "Interruption"; exit 1
	fi

	if ! [ "$DEBUG" = "N" ]; then clear; fi
	echo -e "\n-Liste des $(wc -l<data_node_$VNODE.csv) machines du node '$VNODE':"
	printf "| VM/T |    |        Nom       |    VMId    |     Tags      |\n";
	printf "|------+----+------------------+------------+---------------|\n"
	NBON=0
	IFS=";";while read -a TAB
	do
		if [ ${TAB[3]} == 1 ]; then
			printf "|  T   | - "
		else
			printf "|  VM  | "

			if [ ${TAB[4]} = "stopped" ]; then
				echo -n "🔴"
			else
				echo -n "🟢"
				((NBON++))
			fi
		fi
		printf " | %-16s | %10d | %13s |\n" ${TAB[1]} ${TAB[0]} ${TAB[2]}
	done <data_node_$VNODE.csv
	printf "|------+----+------------------+------------+---------------|\n"
	NBT=$(wc -l <data_template_$VNODE.csv)
	NBTOT=$(wc -l <data_node_$VNODE.csv)
	((NBVM=NBTOT-NBT))
	echo "Bilan: $NBT templates et $NBVM VM, dont $NBON en fonctionnement"
}

#================================================================
function ToolCheck()
{
	which $1 >/dev/null
	if ! [ $? = 0 ]; then
		echo "Error: program '$1' not available, please install"
		exit 1
	fi
}
#================================================================
function VarCheck()
{
	if [ "$1" = "" ]; then
		echo "Error: variable '$2' is empty, please check manual and file '$TOKEN_FILE'"
		exit 1
	fi
}


