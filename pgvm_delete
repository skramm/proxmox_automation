#!/bin/bash

# nom: pgvm_delete
# ce script doit être appelé depuis le script maitre pgvm

# !!!!!!!!!!!! WIP !!!!!!!!!!!!



# désactive l'interprétation de '!' dans une chaine
set +H


declare -a TAGARR

if ! [ -f tags.csv ]
then
	echo "Erreur, fichier 'tags.csv' inaccessible"
	exit 1
fi

IFS=";";while read TAG
do
	TAGARR+=($TAG)
done <tags.csv
echo "TAGARR=${TAGARR[@]}"	


TAGDEL=$(zenity --list --text="Quel machines ayant le tag ci-dessous souhaitez-vous détruire?" --column="tags" ${TAGARR[@]})
if [ $? != 0 ]; then
	echo "Interruption"; exit 1
fi

echo "TAGDEL=$TAGDEL"

START=$(zenity --question --text \
	"Ok pour effacer toutes les VM associées au tag $TAGDEL?")

if [ $? != 0 ]; then
	echo "Interruption"; exit 1
fi
echo "START=$START"
#exit 1

#-------------------------
# Suppression des machines


set +x
COMPT=0
IFS=";";while read -a TAB
do
#	echo "*${TAB[0]}* *${TAB[1]}* *${TAB[2]}* *${TAB[3]}*"
	if ! [ "${TAB[3]}" = "" ]; then
		if [ ${TAB[3]} = $TAGDEL ]; then
			if [ ${TAB[4]} = 0 ]; then
				echo "node ${TAB[0]}: suppression machine ${TAB[2]}, id=${TAB[1]}"
				((COMPT++))
			else
				echo "node ${TAB[0]}: machine ${TAB[2]}, id=${TAB[1]} est un template, pas de suppression"			
			fi
		fi
	fi
done <out_all.csv

echo "-$COMPT VM supprimées"
exit 1

for i in $(seq 1 $NB)
do
	NUM=$i
	if [ 1 = ${#i} ]; then NUM=0$i;fi
	echo "CREATION CLONE i=$NUM"
	
#curl --silent -k \
	response=$(curl -k \
		-H "Authorization: PVEAPIToken=${USER}@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		"https://${APINODE}.univ-rouen.fr:8006/api2/json/nodes/$NODE/qemu/$VMID/clone?node=$NODE&vmid=$VMID&newid=${YEARDAY}${ID}${NUM}&name=${MOD}_$i")
	err=$?
	echo "response=$response err=$err"

	echo "Ajout des tags"

done

