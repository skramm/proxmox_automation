#!/bin/bash

# nom: pgvm_list
# Génération d'une liste de VM
# ce script doit être appelé depuis le script maitre pgvm

# -x pour debug
set +x

# désactive l'interprétation de '!' dans une chaine
set +H

OUT=out_all.csv

if [ -f $OUT ]; then rm $OUT; fi


TODAY=$(date '+%Y%m%d_%H%M%S')
CURLLOG=/tmp/proxmox/curl_$TODAY.log

#---------------------------------------------------------------------------
function process()
{
#	echo "process $1"
	curl --insecure --silent -X GET \
		-H "Authorization: PVEAPIToken=$PVUSER@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
		https://${APINODE}.univ-rouen.fr:8006/api2/json/nodes/$1/qemu | jq -r '.data[]' >/tmp/proxmox/out_$1.json 2>>$CURLLOG
	err=$?
	if ! [ $err = 0 ]
	then
		echo "node '$1': echec!"
		exit 1
	fi
# we use the '_' character to separate fields because in the json file, multiple tags are separated with ';'
	jq -r '(.vmid|tostring) + "_" + .name + "_" + .tags + "_" + (.template|tostring)' < /tmp/proxmox/out_$1.json >/tmp/proxmox/out_$1.csv

# replace null by 0 (machine not a template), just to make it prettier
	sed -i -e 's/_null/_0/g' /tmp/proxmox/out_$1.csv

# replace the semi-colon separating tags with a comma
	sed -i -e 's/;/,/g' /tmp/proxmox/out_$1.csv

# replace the underscore by semi-colon
	sed -i -e 's/_/;/g' /tmp/proxmox/out_$1.csv

# sort by name
	sort --key=1 /tmp/proxmox/out_$1.csv >out_$1.csv
	
# Add node name on each line, first position
	IFS=";";while read line;
	do
		echo "$1;${line}" >> $OUT
 	done < out_$1.csv

	# extraction des template de chaque node
	NBT=0
	if [ -f template_$1.csv ]; then rm template_$1.csv; fi
	IFS=";";while read -a ARR
	do
#		echo "0:${ARR[0]} - 1:${ARR[1]} - 2:${ARR[2]} - 3:${ARR[3]}"
		if [ ${ARR[3]} = 1 ]
		then
			NBT=$((NBT+1))
			echo "${ARR[1]};${ARR[2]};${ARR[0]}" >> template_$1.csv
			echo "$1;${ARR[1]};${ARR[2]};${ARR[0]}" >> template_all.csv
		fi

# comptage du nb d'occurrence pour chaque tag
		if ! [ "${ARR[2]}" = "" ]
		then
			tags=${ARR[2]}
			IFS=","; read -a ARR2 <<< "$tags"; IFS=";"
			for ((i=0;i<${#ARR2[@]}; i++))
			do
				tag=${ARR2[$i]}
				((TAGARR[$tag]++))
				echo "$tag">>/tmp/proxmox/tags.csv
			done
		fi
	done < out_$1.csv

#	echo " -node '$1': $(wc -l <out_$1.csv) machines, dont $NBT template(s)"
	NBTOT=$(wc -l <out_$1.csv)
	((NBVM=NBTOT-NBT))
	printf "| %10s | %5d | %9d | %5d |\n" $1 $NBVM $NBT $NBTOT
	((TOT1+=NBVM))
	((TOT2+=NBT))
	((TOT3+=NBTOT))
}

#---------------------------------------------------------------------------
# liste des nodes 
echo "-Récupération liste des nodes..."
curl --silent -k \
	-H "Authorization: PVEAPIToken=$PVUSER@${REALM}!${TOK_NAME}=${TOK_VALUE}" \
	https://${APINODE}.univ-rouen.fr:8006/api2/json/nodes|jq | jq -r '.data[] | .node' >nodes.csv 2>>$CURLLOG

echo "-Nodes accessibles: $(wc -l < nodes.csv)"

if [ -f /tmp/proxmox/tags.csv ]; then rm /tmp/proxmox/tags.csv; fi
if [ -f template_all.csv ]; then rm template_all.csv; fi

# associative array used to count tags
declare -A TAGARR

echo "|    Node    | Nb VM | Nb Templ. |  Tot  |"
echo "|------------+-------+-----------+-------|"
 
TOT1=0
TOT2=0
TOT3=0

while read -r nodename
do
	process $nodename
done < nodes.csv


echo "|------------+-------+-----------+-------|"
printf "      Totaux | %5d | %9d | %5d |\n" $TOT1 $TOT2 $TOT3

#echo "-Nb templates: $(wc -l<template_all.csv)"
echo -e "\n Available templates: $(wc -l<template_all.csv)"
printf "| %10s | %13s | %15s | %7s |\n" Node Name Tags VMid
echo "|------------+---------------+-----------------+---------|"
IFS=";";while read -a ARR
do
	printf "| %10s | %13s | %15s | %7s |\n" ${ARR[0]} ${ARR[1]} ${ARR[2]} ${ARR[3]}
done < template_all.csv
echo "|------------+---------------+-----------------+---------|"

#echo -e "\n--- Tags ---"


sort /tmp/proxmox/tags.csv >/tmp/proxmox/tags1.csv
uniq /tmp/proxmox/tags1.csv >tags.csv


echo -e "\n|    Tags    | VM+T. |\n|------------+-------|"
for i in "${!TAGARR[@]}"
do
	printf "| %10s | %5d |\n" $i ${TAGARR[$i]}
	((COMPT+=${TAGARR[$i]}))
done
echo "|------------+-------|"
printf "       Total | %5d |\n" $COMPT

exit 0




